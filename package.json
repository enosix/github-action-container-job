{
  "name": "github-action-container-job",
  "author": "Enosix",
  "version": "0.0.0",
  "description": "GitHub Action to run Azure Container App Jobs",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && ncc build -o dist src/index.js && ncc build -o dist/post.js src/post.js",
    "test": "node --test src/test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enosix/github-action-container-job"
  },
  "keywords": [
    "actions",
    "azure",
    "container-apps"
  ],
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/artifact": "^6.0.0",
    "@azure/arm-appcontainers": "^3.0.0",
    "@azure/monitor-query-logs": "^1.0.0",
    "@azure/identity": "^4.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "dotenv": "^17.2.3"
  }
}
